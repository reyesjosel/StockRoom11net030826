@using System.Text.Json
@using Microsoft.JSInterop
@using StockRoom11net.Controls.VisTimeLine
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<h3>DocumentVisComp</h3>
<div @ref="_timelineElement" class="vis-timeline-container"></div>

@code
{
    private ElementReference _timelineElement;
    private IJSObjectReference? _module;

    [Parameter] public TimeLineOptions Options { get; set; } = new();
    [Parameter] public List<TimeLineItem> Items { get; set; } = new();

    #region "JavaScript Isolation (or JS Isolation)"

    /* The technique is called Dynamic Import (or Asynchronous Import). When implemented specifically within
       a front-end framework like Blazor WebAssembly, it is known as JavaScript Isolation (or JS Isolation).

       Blazor leverages the browser's dynamic import capabilities to provide several distinct architectural advantages:
       -> No Global Pollution: The scripts are not loaded globally via <script> tags in your index.html.
                               They are isolated purely to the component that requested them.
       -> Colocation: It allows you to place your .razor.js file right next to your .razor file in your
                               solution explorer, keeping your codebase incredibly organized.
       -> Lazy Loading / Code Splitting: The client's browser won't waste bandwidth downloading your vis.js
                               timeline wrapper code until the exact moment the user navigates to a page
                               containing that specific timeline component.
        
       This component (DocumentVisComp.razor) defines the user-facing API. Properties like Options and Items are
       exposed as parameters, allowing users to configure the timeline. This component uses
       an ElementReference to refer to the DOM element where the timeline will be rendered.

       It uses OnAfterRenderAsync(bool firstRender) to safely initialize the JavaScript instances after the DOM element is attached.
       The JavaScript module is loaded using dynamic import, this loads the JS file in an isolated scope, preventing global namespace pollution.
       Place this JavaScript file directly next to your .razor file (using Blazor CSS/JS isolation).

       To bundle and reference third-party assets like vis-timeline cleanly within a Blazor isolated architecture, you want
       to avoid cluttering your global index.html file.The most robust strategy is to bundle the third-party JavaScript file
       directly into your isolated component script (DocumentVisComp.razor.js) using standard ES modules, while dynamically
       injecting the CSS stylesheet into the DOM only when the component initializes.

       The Isolated JS Component Layer (DocumentVisComp.razor.js)
       Instead of loading vis-timeline.js globally, you can import it at the top of your isolated script (DocumentVisComp.razor.js)
       also called interop layer. This keeps the global scope clean and ensures that the vis-timeline library is only loaded when
       your component is rendered. We continue this example at interop layer (DocumentVisComp.razor.js). */

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load isolated JS file to keep the global scope clean
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/StockRoom11net.Controls.VisTimeLine/DocumentVisComp.razor.js");

            // Serialize options explicitly using System.Text.Json to honor your custom ItemMarginConverter
            var serializedOptions = JsonSerializer.Serialize(Options);
            var serializedItems = JsonSerializer.Serialize(Items);

            await _module.InvokeVoidAsync("initTimeline", _timelineElement, serializedItems, serializedOptions);
        }
    }

    #endregion "JavaScript Isolation (or JS Isolation)"

	#region "Global Script Registration"

    // The traditional alternative to JS Isolation is the Global Script Registration technique.
    // Instead of loading your assets on demand, you register the third-party library globally in your root layout file
    // (index.html for Blazor WebAssembly, or App.razor / _Host.cshtml for Blazor Server).This makes the vis library
    // globally accessible across your entire application from the moment the app boots up.

	// Explore Document_index.html for Blazor WebAssembly or _Host.cshtml for Blazor Server
    // to see how to register the vis-timeline library globally.
    /*
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Serialize options explicitly using System.Text.Json to honor your custom ItemMarginConverter
            var serializedOptions = JsonSerializer.Serialize(Options);
            var serializedItems = JsonSerializer.Serialize(Items);

            // Call the global window property directly
            await JSRuntime.InvokeVoidAsync("visTimelineBridge.initTimeline", _timelineElement, serializedItems, serializedOptions);
        }
    }
    */

	#endregion "Global Script Registration"

    #region "Dynamic Import vs. Global index.html"
    /*
    ╔═════════════╤══════════════════════════════════════════╤═══════════════════════════════════════════════╗
    ║ Feature     │   Dynamic Import (JS Isolation)          │    Global Script (index.html)                 ║
    ╠═════════════╪══════════════════════════════════════════╪═══════════════════════════════════════════════╣
    ║ Initial     │   Faster. App opens quickly; heavy       │    Slower. The user must download Vis.js      ║
    ║ Load Time   │   libraries download only when needed.   │    before the app even displays "Loading...". ║
    ╟─────────────┼──────────────────────────────────────────┼───────────────────────────────────────────────╢
    ║ Namespace   │   High. Variables are trapped inside     │    Low. Registers vis on the global window    ║
    ║ Safety      │   the module file scope.                 │    object, risking version conflicts.         ║
    ╟─────────────┼──────────────────────────────────────────┼───────────────────────────────────────────────╢
    ║ Ease of     │   Excellent. The NuGet consumer          │    Poor. The developer installing your        ║
    ║ Packaging   │   just writes <VisTimeline/>.            │    library must manually copy/paste tags      ║
    ║             │   No manual setup.                       │    into their HTML.                           ║
    ╟─────────────┼──────────────────────────────────────────┼───────────────────────────────────────────────╢
    ║ Caching     │   Efficient. Modules can be cached by    │    Inefficient. Global scripts are not        ║
    ║ Behavior    │   the browser.                           │    easily cacheable.                          ║
    ╚═════════════╧══════════════════════════════════════════╧═══════════════════════════════════════════════╝    
    */
	#endregion "Dynamic Import vs. Global index.html"


    /// <summary>
    /// This call updates the timeline options dynamically. It serializes the new options and
    /// invokes the JavaScript function <c>setTimelineOptions</c> to update the timeline configuration.
    /// </summary>
    /// <param name="newOptions">The new timeline options to apply.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    public async Task UpdateOptionsAsync(TimeLineOptions newOptions)
    {
        if (_module is not null)
        {
            Options = newOptions;
            var serializedOptions = JsonSerializer.Serialize(Options);
            await _module.InvokeVoidAsync("setTimelineOptions", _timelineElement, serializedOptions);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroyTimeline", _timelineElement);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* Handle safe disconnection */ }
        }
    }

}