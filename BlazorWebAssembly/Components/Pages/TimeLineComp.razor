@using System.ComponentModel;
@using Microsoft.AspNetCore.Components;
@using StockRoom11net.BlazorWebAssembly
@using StockRoom11net.BlazorWebAssembly.Components
@using StockRoom11net.BlazorWebAssembly.Components.Pages
@using StockRoom11net.BlazorWebAssembly.Data
@using global::StockRoom11net.Controls.VisTimeLine
@inject IJSRuntime JSRuntime
@inject AppService AppService
@implements IDisposable


@code
{
    #region *****************  "Lifecycle Events Documentation"  ***********

    /* sequenceDiagram
    participant F as Framework
    participant C as Component

    F->>C: 1. SetParametersAsync()
    Note over C: Receives [Parameter] values<br/>from parent or route

    F->>C: 2. OnInitialized()
    F->>C: 3. OnInitializedAsync()
    Note over C: Runs ONCE on first creation<br/>Good for initial data loading

    F->>C: 4. OnParametersSet()
    F->>C: 5. OnParametersSetAsync()
    Note over C: Runs every time parameters change<br/>Including the first time

    F->>C: 6. BuildRenderTree()
    Note over C: Renders the component to DOM<br/>ShouldRender() gates this step
    // BuildRenderTree() is auto-generated by the Razor compiler from your .razor markup. Manually
    // overriding it in a .razor file will conflict with the generated rendering — remove it entirely.

    F->>C: 7. OnAfterRender(firstRender)
    F->>C: 8. OnAfterRenderAsync(firstRender)
    Note over C: DOM is ready — safe for JS interop<br/>firstRender=true only on first render

    Note over F,C: === Parameter Change / StateHasChanged() ===

    F->>C: OnParametersSet() / OnParametersSetAsync()
    F->>C: BuildRenderTree()
    F->>C: OnAfterRender() / OnAfterRenderAsync()

    Note over F,C: === Component Removed from DOM ===

    F->>C: 9. Dispose() / DisposeAsync()
    Note over C: Unsubscribe events, release resources
     */

    #endregion *****************    "Lifecycle Events Documentation"    ***********

	#region *****************  Parameters/EventCallbacks    *****************

	// Those parameters are passed from the parent component to this TimeLineComp component.
    // When the parent component declares (initialization) the TimeLineComp component, it can set these parameters
    // to configure the timeline's behavior and appearance.
	// Parameters
    [Parameter] public string? ElementId { get; set; }
    [Parameter] public IEnumerable<TimeLineItem>? Items { get; set; }
    [Parameter] public IEnumerable<TimelineGroup>? Groups { get; set; }
    [Parameter] public object? Options { get; set; }

	// This eventCallback are available for the parent component at declaration (initialization) time of the TimeLineComp component.
    // The parent component can subscribe to these events
    // EventCallbacks
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public EventCallback<TimeLineItem> OnMove { get; set; }
    [Parameter] public EventCallback<TimeLineItem> OnResize { get; set; }
    [Parameter] public EventCallback<(DateTime start, DateTime end)> OnRangeChanged { get; set; }
    [Parameter] public EventCallback<CanvasMouseArgs> MouseDown { get; set; }
    [Parameter] public EventCallback<CanvasMouseArgs> MouseUp { get; set; }
    [Parameter] public EventCallback<CanvasMouseArgs> MouseMove { get; set; }

	#endregion *****************    Parameters/EventCallbacks    *****************
   
	#region *****************  This are component's Lifecycle Events    ******

    // #1 Receives [Parameter] values from parent or route
    // — must call base or parameters won't be set
    public override Task SetParametersAsync(ParameterView parameters)
    {
        // This method is called when the component's parameters are set or updated.
        // It can be used to perform any necessary actions based on the new parameter values.
        // For example, you might want to update the timeline data or options based on the new parameters.

        // Perform any actions based on new parameter values here.
        return base.SetParametersAsync(parameters);        
    }

    // #3 Runs ONCE on first creation. Good for initial data loading
    protected override async Task OnInitializedAsync()
    {
        // This method is called when the component is initialized.
        // It can be used to perform any necessary setup or initialization tasks.
        // For example, you might want to load initial data or configure the timeline options.
    }

    // #5 Runs every time parameters change, Including the first time
    protected override async Task OnParametersSetAsync()
    {
        // This method is called when the component's parameters are set or updated.
        // It can be used to perform any necessary actions based on the new parameter values.
        // For example, you might want to update the timeline data or options based on the new parameters.
    }
    
    // Store the lambda reference so it can be unsubscribed later
	Action<string>? _initializeDataHandler;
    Action<string>? _upDateTimeLineHandler;
    Action<TimeLineItem>? _upDateItemHandler;
    Action<string>? _selectItemHandler;

    /// <summary>
    /// Reference to the current instance of the TimeLineComp component.
    /// This is used to create a DotNetObjectReference for JavaScript interop
    /// calls back using invokeMethodAsync("NotifySelect", id);<br/>
    /// </summary>
    DotNetObjectReference<TimeLineComp>? selfRef;
    DotNetObjectReference<AppService>? refAppService;

    // #8 DOM is ready — safe for JS interop, firstRender=true only on first render
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // This method is called after the component has been rendered to the DOM.
        // It can be used to perform any necessary actions that require access to the DOM.
        // For example, you might want to initialize JavaScript interop or set up event listeners.
    
        // This method is called when the component's parameters are set or updated.
        if (firstRender)
        {
            // Create a DotNetObjectReference for the current instance of the TimeLineComp component
            // This allows JavaScript to call C# methods on this instance using the reference, and it
            // is passed to the JavaScript interop function to enable callbacks from JavaScript to C#.
            selfRef = DotNetObjectReference.Create(this);
            refAppService = DotNetObjectReference.Create(AppService);
            await JSRuntime.InvokeVoidAsync("vis_timeline_bridge.create", ElementId, Items, Groups, Options, selfRef, refAppService);

            // Store the handler in a field — anonymous lambdas cannot be unsubscribed
            _initializeDataHandler = async (data) =>
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("vis_timeline_bridge.initializeData", ElementId, data);
                }
                catch (JSException ex)
                {
                    // timeline.redraw() failed — log it but don't crash the component.
                    // The DataSet was already updated reactively, so items will still render.
                    Console.WriteLine($"[TimeLineComp] initializeData JS error: {ex.Message}");
                }
            };

            _upDateTimeLineHandler = async (data) =>
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("vis_timeline_bridge.updateData", ElementId, data);
                }
                catch (JSException ex)
                {
                    Console.WriteLine($"[TimeLineComp] updateData JS error: {ex.Message}");
                }
            };

            _upDateItemHandler = async (data) =>
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("vis_timeline_bridge.updateItem", ElementId, data);
                }
                catch (JSException ex)
                {
                    Console.WriteLine($"[TimeLineComp] updateItem JS error: {ex.Message}");
                }
            };

            _selectItemHandler = async (data) =>
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("vis_timeline_bridge.selectItem", ElementId, data);
                }
                catch (JSException ex)
                {
                    Console.WriteLine($"[TimeLineComp] selectItem JS error: {ex.Message}");
                }
            };

			// Subscribe to the AppService events using the stored handler references
            AppService.InitializeDataEvent += _initializeDataHandler;
            AppService.UpDateTimeLineEvent += _upDateTimeLineHandler;
            AppService.UpDateItemEvent += _upDateItemHandler;
            AppService.SelectItemEvent += _selectItemHandler;  
            
            // Notify AppService that the vis-timeline JS instance is now ready.
            // This drains any data that WinForms buffered before this render, and signals
            // WinForms via TimelineReadyEvent so it knows it can safely call InitializeData.
            AppService.NotifyTimelineReady();
        }
    }

	// #9 Component Removed from DOM, Framework calls Dispose() to allow
    // the component to clean up resources and unsubscribe from events.
    public void Dispose()
    {
        AppService.InitializeDataEvent -= _initializeDataHandler;
        AppService.UpDateTimeLineEvent -= _upDateTimeLineHandler;
		AppService.UpDateItemEvent -= _upDateItemHandler;
        AppService.SelectItemEvent -= _selectItemHandler;

		// Dispose of the DotNetObjectReference to release resources and prevent memory leaks
        selfRef?.Dispose();
        refAppService?.Dispose();
    }

    #endregion *****************    This component's Lifecycle Events    ******

    #region *****************  JSRuntime → C#   **************************
    // This section contains methods invoked from JavaScript to notify C# methods in the Blazor component about events
    // originating from timelineInterop.js. These methods are marked with the [JSInvokable] attribute to allow JavaScript
    // to call them through the DotNetObjectReference ( selfRef ) created in OnAfterRenderAsync and passed to the
    // JavaScript interop function.

    /// <summary>
    /// Called by JavaScript to notify the Blazor component of a selection event.
    /// </summary>
    /// <param name="id">The ID of the selected item.</param>
    /// <returns></returns>
    [JSInvokable]
    public async Task NotifySelect(string id) => await OnSelect.InvokeAsync(id);

    /// <summary>
    /// Called by JavaScript to notify the Blazor component of a move event.
    /// </summary>
    /// <param name="item">The item that was moved.</param>
    /// <returns></returns>
    [JSInvokable]
    public async Task NotifyMove(TimeLineItem item) => await OnMove.InvokeAsync(item);

    /// <summary>
    /// Called by JavaScript to notify the Blazor component of a resize event.
    /// </summary>
    /// <param name="item">The item that was resized.</param>
    /// <returns></returns>
    [JSInvokable]
    public async Task NotifyResize(TimeLineItem item) => await OnResize.InvokeAsync(item);

    /// <summary>
    /// Called by JavaScript to notify the Blazor component of a range change event.
    /// </summary>
    /// <param name="start">The start of the new range.</param>
    /// <param name="end">The end of the new range.</param>
    /// <returns></returns>
    [JSInvokable]
    public async Task NotifyRangeChanged(DateTime start, DateTime end) => await OnRangeChanged.InvokeAsync((start, end));

    /// <summary>
    /// Called by JavaScript to notify the Blazor component of a mouse down event.
    /// </summary>
    /// <param name="args">The arguments for the mouse down event.</param>
    /// <returns></returns>
    [JSInvokable]
    public async Task OnMouseDown(CanvasMouseArgs args)
    {
        await MouseDown.InvokeAsync(args);
    }

    /// <summary>
    /// Called by JavaScript to notify the Blazor component of a mouse up event.
    /// </summary>
    /// <param name="args">The arguments for the mouse up event.</param>
    /// <returns></returns>
    [JSInvokable]
    public async Task OnMouseUp(CanvasMouseArgs args)
    {
        await MouseUp.InvokeAsync(args);
    }

    /// <summary>
    /// Called by JavaScript to notify the Blazor component of a mouse move event.
    /// </summary>
    /// <param name="args">The arguments for the mouse move event.</param>
    /// <returns></returns>
    [JSInvokable]
    public async Task OnMouseMove(CanvasMouseArgs args)
    {
        // Invoke the MouseMove event callback with the provided arguments
        await MouseMove.InvokeAsync(args);
    }

    #endregion *****************    JSRuntime → C#   **************************

    #region *****************  C# → JS calls   **************************
	// This are public methods that can be called from C# code in the Blazor page ( parent component )
    // to interact with the JavaScript timelineInterop component. Invoke JavaScript functions through
    // the JSRuntime to perform actions on the timelineinterop component in the browser.
	// This allows the Blazor component to control the timeline's behavior and appearance from C# code.
	// This is the standard way to call JavaScript functions from C# in Blazor using JSRuntime.
	// Blazor page ( parent component ) --> TimeLineComp component ( C# ) --> JSRuntime --> timelineInterop.js ( JS ) --> Vis.js Timeline ( JS )
    // C# → JS
    /// <summary>
    /// Update the timeline data with the provided JSON string.
    /// </summary>
    /// <param name="data">The JSON string representing the new timeline data.</param>
    /// <returns></returns>
    public async Task UpDateData(string data) => await JSRuntime.InvokeVoidAsync("timelineInterop.upDateData", ElementId, data);

    /// <summary>
    /// Add a new item to the timeline.
    /// </summary>
    /// <param name="item">The item to be added to the timeline.</param>
    /// <returns></returns>
    public async Task AddItem(TimeLineItem item) => await JSRuntime.InvokeVoidAsync("timelineInterop.addItem", ElementId, item);

    /// <summary>
    /// Update an existing item in the timeline.
    /// </summary>
    /// <param name="item">The item to be updated in the timeline.</param>
    /// <returns></returns>
    public async Task UpdateItem(TimeLineItem item) => await JSRuntime.InvokeVoidAsync("timelineInterop.updateItem", ElementId, item);

    /// <summary>
    /// Remove an item from the timeline by its ID.
    /// </summary>
    /// <param name="id">The ID of the item to be removed from the timeline.</param>
    /// <returns></returns>
    public async Task RemoveItem(int id) => await JSRuntime.InvokeVoidAsync("timelineInterop.removeItem", ElementId, id);

    public async Task ZoomIn() => await JSRuntime.InvokeVoidAsync("timelineInterop.zoomIn", ElementId);
    public async Task ZoomOut() => await JSRuntime.InvokeVoidAsync("timelineInterop.zoomOut", ElementId);
    public async Task MoveLeft() => await JSRuntime.InvokeVoidAsync("timelineInterop.moveLeft", ElementId);
    public async Task MoveRight() => await JSRuntime.InvokeVoidAsync("timelineInterop.moveRight", ElementId);
    
    #endregion *****************   C# → JS calls   **************************

}