@page "/timeline"
@using StockRoom11net.BlazorWebAssembly.Components.Pages
@using StockRoom11net.Controls.VisTimeLine
@inject IJSRuntime JSRuntime
@inject ITimeLineService itimeLineService


<head>
    <style>
        :root {
            --color-background: #FFF;
            --color-foreground: #333;
            --color-items-text: #000;
            --color-items-border: #333;
            --color-items-background: #CCCCCC;
            --color-items-background-hover: #999999;
            --color-items-background-seledted-hover: #EEEEEE;
            --color-dark: #000;
            --color-theme: #c34528;
            --color-theme-dark: filter: brightness(85%);
            --color-theme-complement: spin( --color-theme, 180);
            --color-theme-triad1: spin( --color-theme, -135);
            --color-theme-triad2: spin( --color-theme, 135);
            --color-theme-split1: spin( --color-theme, -158);
            --color-theme-split2: spin( --color-theme, 158);
            --color-text: lch(from var(--color-foreground) calc(l + 25%) c h); /* Increase lightness by 25% */
            --color-header-text: var(--color-dark);
            --color-text-inverted: darken( --color-background,5);
            --color-header-text-inverted: var(--color-background);
            --color-text-credit: #999999;
            --color: ActiveBorder;
        }

        html {
            height: 100%;
        }

        body {
            display: grid;
            grid-template-rows: 1fr auto;
            padding: 0;
            min-height: 100%;
            background-color: var(--color-background);
            color: var(--color-foreground);
            font-family: Arial, sans-serif;
        }

        footer {
            grid-row-start: 2;
            grid-row-end: 3;
        }

			/* ── Context Menu Styles ─────────────────────────────── */
            .tl-ctx-backdrop {
                position: fixed;
                inset: 0;
                z-index: 999;
            }

            .tl-ctx-menu {
                position: fixed;
                z-index: 1000;
                background: #fff;
                border: 1px solid #ccc;
                border-radius: 3px;
                box-shadow: 2px 2px 6px rgba(0,0,0,.2);
                padding: 1px 0;
                min-width: 80px;
                font-size: 10px;
            }

            .tl-ctx-menu-item {
                padding: 2px 8px;
                cursor: pointer;
                user-select: none;
                line-height: 1.4;
            }

                .tl-ctx-menu-item:hover {
                        background: #f0f0f0;
                    }
           
    </style>
	
</head>

<body>
    <main>
        <p>Welcome to my website!</p>
        <img src="/Resources/img/comment_48.png" style="width:48px;height:48px;" />
        @ChildContent        
    </main>
    <footer>
        <div id="@ElementId"></div>

        <TimeLineComp @ref="_timelinecomp"
                      Options="@TimeLineOptions"
                      ElementId="@ElementId"
                      OnSelect="SelectEvent"
                      OnMove="MoveEvent"
                      OnResize="ResizeEvent"
                      OnRangeChanged="RangeEvent"
                      OnContextMenu="@OnContextMenu"
                      EnableContextMenu="true">

         <ContextMenuItems Context="ctx">
            @if (ctx.ItemId is not null)
            {
                <div class="tl-ctx-menu-item" @onclick="() => OnCtxEditItem(ctx.ItemId!)">✏️ Edit</div>
                <div class="tl-ctx-menu-item" @onclick="() => OnCtxDeleteItem(ctx.ItemId!)">🗑️ Delete</div>
            }
            else
            {
                <div class="tl-ctx-menu-item" @onclick="() => OnCtxAddItemAt(ctx.Time)">➕ Add item here</div>
            }
			@if(_argsContextMenuComp.ShowMajorLabels)
			{
			    <div class="tl-ctx-menu-item" @onclick="OnCtxMonthLabelToggle">🗓️ Hide Month Labels</div>
			}
			else
			{
			    <div class="tl-ctx-menu-item" @onclick="OnCtxMonthLabelToggle">🗓️ Show Month Labels</div>
			}
        </ContextMenuItems>

        </TimeLineComp>

    </footer>
</body>

@* #region Context Menu page level *@
@if (_pageCtxVisible)
{
    <div class="tl-ctx-backdrop" @onclick="PageContextMenuClose"></div>
    <div class="tl-ctx-menu" style="@($"left:{_pageCtxX}px; top:{_pageCtxY}px")"@onclick="PageContextMenuClose">
        <div class="tl-ctx-menu-item" @onclick="OnCtxPageAction1">⚙️ Page action 1</div>
        <div class="tl-ctx-menu-item" @onclick="OnCtxPageAction2">⚙️ Page action 2</div>
        <div class="tl-ctx-menu-item" @onclick="OnDevToolsWindow">⚙️ Developer Tools</div>
    </div>
}
@* #endregion Context Menu page level  *@


@code {
    /// <summary>
    /// In a Blazor App, you would wrap a BECanvas element
    /// in the CanvasHelper
    /// </summary>
    [Parameter] public RenderFragment ChildContent { get; set; }

    /// <summary>
    /// Reference to the JavaScript module for interop.
    /// In OnAfterRenderAsync(), we dynamically import the JavaScript module "./Components/Pages/TimeLineComp.razor.js"
    /// </summary>
    private IJSObjectReference? _module;

    /// <summary>
    /// Unique identifier for the timeline element div.
    /// </summary>
    string ElementId = "timeline-" + Guid.NewGuid().ToString("N");

    private TimeLineComp? _timelinecomp;

    List<TimelineGroup> Groups = new()
    {
        new() { Id = 0, Content = "" },
        new() { Id = 1, Content = "Group A" },
        new() { Id = 2, Content = "Group B" }
    };

    List<TimeLineItem> Items = new()
    {
        new() { Id = "0", Content = "Item 0", Start = DateTime.Today.AddDays(-10), Editable = new TimeLineItemEditableOptions(){ UpdateTime = true, UpdateGroup = true, Remove = false } },
        new() { Id = "1", Group = "1", Content = "Item A", Start = DateTime.Today, Editable = false },
		new() { Id = "2", Group = "2", Content = "Item B", Start = DateTime.Today.AddDays(1)}, // Editable defaults to true
        new() { Id = "3", Content = "Resizable Item", Start = DateTime.Parse("2025-12-10"), End = DateTime.Parse("2025-12-12"), Editable = true },
        new() { Id = "4", Content = "Fixed Duration Item", Start = DateTime.Parse("2025-12-15"), End = DateTime.Parse("2025-12-16"), Editable = false }
    };

    object TimeLineOptions = new TimeLineOptions
    {
        Start = new DateTime(2025, 9, 1),
        End = new DateTime(2026, 2, 10),
        Min = new DateTime(2020, 12,01, 12, 00, 00),
        Max = DateTime.Today + TimeSpan.FromDays(200),
        //Height = "100px",
        MaxHeight = "150px",//"25%"
        MinHeight = "50px",
        ShowCurrentTime = true,
        Selectable = true,
        Moveable = true,
        ShowMajorLabels = false,                    // hides day/month/year row
        ShowMinorLabels = true,                     // keeps hours/minutes row
        HorizontalScroll = false,
        VerticalScroll = false,
        //ZoomKey = "ctrlKey",                      // optional: prevent accidental zoom
        Stack = false,
        Multiselect = false,
        ZoomMin = 1000 * 60 * 60 * 24,            // One day in milliseconds  // 1000 * 60 * 60, -> 1 hour
        ZoomMax = 1000L * 60 * 60 * 24 * 30 * 18, // 1000L * 60 * 60 * 24 * 30 -> 30 days
        Editable = new TimeLineEditableOptions
        {
            Add = true,
            UpdateTime = true,
            UpdateGroup = true,
            Remove = true
        },        
        Margin = new TimeLineMargin
        {
            Item = new ItemMargin
            {
				Horizontal = 5,     // Set horizontal space between items explicitly
				Vertical = 4        // Set vertical space between items explicitly,
                // it's items margin, the space will be doubled when stacked
            },
            Axis = 5                // Set space between items and the time axis
        },
        Orientation = "bottom",

        Format = new TimeLineFormatOptions
        {
            MinorLabels = new Dictionary<string, string>
            {
                // sub-day
                ["millisecond"] = "SSS",
                ["second"] = "HH:mm:ss",
                ["minute"] = "HH:mm",
                ["hour"] = "HH:mm",

                // date
                ["weekday"] = "ddd D",
                ["day"] = "D",
                ["month"] = "MMM",
                ["year"] = "YYYY"
            },

            MajorLabels = new Dictionary<string, string>
            {
                // sub-day
                ["millisecond"] = "HH:mm",
                ["second"] = "HH:mm",
                ["minute"] = "HH:mm",
                ["hour"] = "MMM D HH:mm",
                // date
                ["weekday"] = "MMM D",
                ["day"] = "MMMM YYYY",
                ["month"] = "YYYY",
                ["year"] = ""
            }
        }
	};

    #region ********  JSRuntime → C#   **************************

    /// <summary>
    /// Handles the selection of a timeline item.
    /// This method is called when a user selects an item on the timeline visible area (clicks on it)
    /// and wire through the OnSelect="SelectEvent" event on the TimeLineComp component.
    /// </summary>
    /// <param name="id">The ID of the selected timeline item.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    async Task SelectEvent(string id)
    {
        await itimeLineService.NotifySelect(id);
    }

    /// <summary>
    /// Handles the movement of a timeline item.
    /// This method is called when a user moves an item on the timeline axis (changes its start date)
    /// and wire through the OnMove="MoveEvent" event on the TimeLineComp component.
    /// </summary>
    /// <param name="item">The timeline item that was moved.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    async Task MoveEvent(TimeLineItem item)
    {
        await itimeLineService.NotifyMoved(item);
    }

    /// <summary>
    /// Handles the resizing of a timeline item.
    /// This method is called when a user resizes an item on the timeline
    /// and wire through the OnResize="ResizeEvent" event on the TimeLineComp component.
    /// Only applicable for items that have an end date (i.e., range items).
    /// </summary>
    /// <param name="item">The timeline item that was resized.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    async Task ResizeEvent(TimeLineItem item)
    {
        await itimeLineService.NotifyResize(item);
    }

    /// <summary>
    /// Handles the change of the range on the timeline.
    /// This method is called when the visible range of the timeline changes
    /// and wire through the OnRangeChanged="RangeEvent" event on the TimeLineComp component.
    /// This is the axis range, not the item range. The timeline can be zoomed or panned, which changes the visible range.
    /// </summary>
    /// <param name="start">The start time of the range.</param>
    /// <param name="end">The end time of the range.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    async Task RangeEvent((DateTime start, DateTime end) range)
    {
        await itimeLineService.NotifyRangeChanged(range.start, range.end);
    }

    #endregion *****************  JSRuntime → C#   **************************

    #region ********  This are pages's Lifecycle Events    ******

    /// <summary>
    /// OnInitialize we add event handlers to the AppService.MessageReceived event.
    /// </summary>
    protected override void OnInitialized()
    {
        // _appService.MessageReceivedEvent += HandleMessage;
        //  _appService.UpDateTimeLineEvent += UpDateData;
        //  _appService.UpDateItemEvent += ItemUpDate;               
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Pages/TimeLineComp.razor.js");

            _pageRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerPageContextMenu", _pageRef);
        }
    }

    #endregion *****  This are pages's Lifecycle Events end.    ******

    #region ********  C# → JS calls   ***************************
    // This are the methods that are called by the AppService event handlers whenever the data needs to be updated.
    // They are wired through the OnUpdate="UpDateData" event and  on the TimeLineComp component.

    /// <summary>
    /// This method is called by the AppService event handlers whenever the data is updated.
    /// OnInitialized we add event handlers to the _appService.UpDateTimeLineEvent += UpDateData; event.
    /// We are not using through the page level, we inject the AppService directly to the TimeLineComp component
    /// and skip the page level, but we are showing it here for demonstration purposes.
    /// </summary>
    public async void UpDateData(string message)
    {
        await InvokeAsync(async () => await _timelinecomp!.UpDateData(message));
    }

    /// <summary>
    /// This method is called by the AppService event handlers whenever the item needs to be updated.
    /// and wire through the _appService.UpDateItemEvent += ItemUpDate; event.
    /// It is standard practice when injecting AppServices to the page level,
    /// to add event handlers to the AppService events in OnInitialized and remove them in Dispose.
    /// We are not using through the page level, we inject the AppService directly to the TimeLineComp component
    /// and skip the page level, but we are showing it here for demonstration purposes.
    /// </summary>
    /// <param name="item">The timeline item that was updated.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    async void ItemUpDate(TimeLineItem item)
    {
        await InvokeAsync(async () => await _timelinecomp!.UpdateItem(item));
    }

    #endregion *****************  C# → JS calls   **************************

    #region ********  Context Menu Component level **************

    /// <summary>
    /// Holds the arguments for the context menu component.
    /// </summary>
    TimeLineContextMenuArgs _argsContextMenuComp = new TimeLineContextMenuArgs();

    async Task OnContextMenu(TimeLineContextMenuArgs args)
    {
        _argsContextMenuComp = args;
    }

    void OnCtxEditItem(string itemId)
    {
        // TODO: open your edit dialog / form for the item with this id
    }

    void OnCtxDeleteItem(string itemId)
    {
        // TODO: remove the item from your data source and refresh the timeline
    }

    void OnCtxAddItemAt(DateTime? time)
    {
        // TODO: open your add-item dialog pre-filled with this timestamp
    }

    /// <summary>
    /// Toggles the visibility of the major labels on the timeline.
    /// Flow: User right-clicks on the timeline → Context menu appears → User clicks "Toggle Month Labels" →
    /// OnCtxMonthLabelToggle is invoked → ToggleMajorLabels() → itimeLineService.SetMajorLabels() ->
    /// SetMajorLabelsEvent fires → TimeLineComp._setMajorLabelsHandler ->
    /// interop.InvokeVoidAsync("setMajorLabels") → _timeline.setOptions({showMajorLabels}).
    /// </summary>
    /// <returns>A task that represents the asynchronous operation.</returns>
    async Task OnCtxMonthLabelToggle()
	{
		await ToggleMajorLabels();
	}

    // In your Blazor component
	private bool _showMajorLabels = false; // Track the current state of major labels, we initialize at 
                                           // TimeLineOptions -> ShowMajorLabels = false, // hides day/month/year row

    private async Task ToggleMajorLabels()
    {
        _showMajorLabels = !_argsContextMenuComp.ShowMajorLabels;

        itimeLineService.SetMajorLabels(_showMajorLabels, true);
    }

    #endregion ****** Context Menu Component level ******

    #region ********  Context Menu Page level *******************

    /// <summary>When false the right-click context menu is completely suppressed. Default is true.</summary>
    [Parameter] public bool EnableContextMenu { get; set; } = true;

    /// <summary>
    /// Optional menu items rendered inside the built-in context menu popup.
    /// Receives the <see cref="TimeLineContextMenuArgs"/> of the right-click so items
    /// can be hidden/disabled based on whether an item or empty space was clicked.
    /// If not set, no popup is shown and only <see cref="OnContextMenu"/> fires.
    /// </summary>
    [Parameter] public RenderFragment<TimeLineContextMenuArgs>? ContextMenuItems { get; set; }

    // ── context-menu overlay state ────────────────────────────────────────────
    bool _ctxVisible = true;
    double _ctxX;
    double _ctxY;
    TimeLineContextMenuArgs _ctxArgs = new();

    private bool _pageCtxVisible;
    private double _pageCtxX;
    private double _pageCtxY;
    private TimeLineContextMenuArgs _pageCtxArgs = new();
    private DotNetObjectReference<TimeLinePage>? _pageRef;

    private void OnCtxPageAction1()
    {
        // your logic here for right-click outside the timeline - action 1
    }

    private void OnCtxPageAction2()
    {
        // your logic here for right-click outside the timeline - action 2
    }

	private void OnDevToolsWindow()
	{
		// your logic here for right-click outside the timeline - action 2
        itimeLineService.OpenDevToolsWindow();
	}

    [JSInvokable]
    public async Task PageContextMenuOpen(TimeLineContextMenuArgs args)
    {
        _pageCtxArgs = args;
        _pageCtxX = args.ClientX;
        _pageCtxY = args.ClientY;
        _pageCtxVisible = true;
        _ctxVisible = ContextMenuItems is not null;  // only show popup if items were provided

        if (_ctxVisible) StateHasChanged();
        await InvokeAsync(StateHasChanged);  // ← must use InvokeAsync from JS callbacks
    }

    [JSInvokable]
    public async Task PageContextMenuClose()
    {
        _pageCtxVisible = false;
        await InvokeAsync(StateHasChanged);
    }
    
    #endregion ****** Context Menu Page level ******

    public async ValueTask DisposeAsync()
    {
        await _module.InvokeVoidAsync("unregisterPageContextMenu");

        _pageRef?.Dispose();

        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }

	public void Dispose()
	{        
		itimeLineService.UpDateTimeLineEvent -= UpDateData;
		itimeLineService.UpDateItemEvent -= ItemUpDate;
	}	
}
